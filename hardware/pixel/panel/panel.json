{
  "layout": {
    "type": "grid",
    "rows": 4,
    "cols": 4,
    "hspace": "2mm",
    "vspace": "2mm",
    "hbackbone": "3mm",
    "vbackbone": "0mm",
    "rotation": "0deg",
    "vbonecut": false,
    "hbonecut": false
  },
  "tabs": {
    "type": "fixed",
    "vwidth": "3mm",
    "hwidth": "3mm",
    "vcount": 1,
    "hcount": 0,
    "mindistance": "0mm"
  },
  "cuts": {
    "type": "mousebites",
    "drill": "0.5mm",
    "spacing": "0.8mm",
    "offset": "0mm",
    "prolong": "0.5mm"
  },
  "framing": {
    "type": "frame",
    "width": "5mm",
    "space": "2mm",
    "cuts": "none"
  },
  "tooling": {
    "type": "4hole",
    "hoffset": "2.5mm",
    "voffset": "2.5mm",
    "size": "1.152mm"
  },
  "fiducials": {
    "type": "3fid",
    "hoffset": "6mm",
    "voffset": "2.5mm",
    "coppersize": "1mm",
